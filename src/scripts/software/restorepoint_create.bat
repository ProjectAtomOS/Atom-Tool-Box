@echo off
powershell -NoProfile -Command "$sr = 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\SystemRestore'; $freq = (Get-ItemProperty -Path $sr -Name 'SystemRestorePointCreationFrequency' -ErrorAction SilentlyContinue).SystemRestorePointCreationFrequency; Set-ItemProperty -Path $sr -Name 'SystemRestorePointCreationFrequency' -Value 0 -Type DWord -Force; Enable-ComputerRestore -Drive ($env:SystemDrive + '\') -ErrorAction SilentlyContinue; try { Checkpoint-Computer -Description 'AtomToolBox' -RestorePointType 'MODIFY_SETTINGS' -ErrorAction Stop; $ok = $true } catch { $ok = $false; Write-Host $_.Exception.Message }; if ($null -eq $freq) { Remove-ItemProperty -Path $sr -Name 'SystemRestorePointCreationFrequency' -ErrorAction SilentlyContinue } else { Set-ItemProperty -Path $sr -Name 'SystemRestorePointCreationFrequency' -Value $freq -Type DWord -Force }; if ($ok) { Write-Host 'RESTORE_POINT_CREATED'; exit 0 } else { exit 1 }"
exit /b %errorlevel%
