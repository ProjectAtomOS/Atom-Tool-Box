{
  "name": "atom-toolbox",
  "version": "0.2.0",
  "private": true,
  "description": "A Windows 10/11 tweak and system utility toolbox built with Electron.",
  "license": "MIT",
  "author": "Project Atom",
  "copyright": "Copyright © 2026 Project Atom",
  "repository": {
    "type": "git",
    "url": "https://github.com/ProjectAtomOS/Atom-Tool-Box.git"
  },
  "homepage": "https://github.com/ProjectAtomOS/Atom-Tool-Box#readme",
  "bugs": {
    "url": "https://github.com/ProjectAtomOS/Atom-Tool-Box/issues"
  },
  "main": "main.js",
  "scripts": {
    "start": "node ./node_modules/electron/cli.js .",
    "dev": "node ./node_modules/electron/cli.js . --dev",
    "check": "node --check main.js && node --check src/renderer.js",
    "build": "node ./node_modules/electron-builder/cli.js --win nsis",
    "dist": "node ./node_modules/electron-builder/cli.js --win nsis"
  },
  "build": {
    "appId": "com.projectatom.toolbox",
    "productName": "AtomToolBox",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "src/**/*",
      "power-plans/**/*",
      "assets/**/*"
    ],
    "asarUnpack": [
      "src/scripts/**/*",
      "power-plans/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/app.png",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AtomToolBox",
      "artifactName": "AtomToolBox-Setup-${version}.exe",
      "include": "build/installer.nsh"
    }
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^25.1.7"
  }
}
